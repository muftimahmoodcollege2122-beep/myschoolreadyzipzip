# ================================================================
#  EduOS Environment Variables — Copy to .env and fill in values
# ================================================================

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL="postgresql://eduos:password@localhost:5432/eduos"
POSTGRES_USER=eduos
POSTGRES_PASSWORD=supersecretpassword
POSTGRES_DB=eduos

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=

# ── JWT Auth ─────────────────────────────────────────────────────
JWT_SECRET=your-256-bit-jwt-secret-change-this-in-production
JWT_EXPIRY=7d
JWT_REFRESH_SECRET=your-256-bit-refresh-secret
JWT_REFRESH_EXPIRY=30d

# ── API ──────────────────────────────────────────────────────────
API_PORT=4000
API_URL=https://api.myschool.pk
CORS_ORIGINS=https://admin.myschool.pk,https://teach.myschool.pk,https://learn.myschool.pk,https://parent.myschool.pk,https://myschool.pk

# ── Next.js Apps ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.myschool.pk

# ── Email (SMTP) ─────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@myschool.pk
SMTP_PASS=your-smtp-password
SMTP_FROM="EduOS <noreply@myschool.pk>"

# ── Pakistani Payment Gateways ────────────────────────────────────
EASYPAISA_MERCHANT_ID=
EASYPAISA_MERCHANT_PASSWORD=
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_API_URL=https://easypay.easypaisa.com.pk/trc

JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_RETURN_URL=https://myschool.pk/payment/verify
JAZZCASH_API_URL=https://payments.jazzcash.com.pk/ApplicationAPI/API

# ── PayPal ───────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# ── Bank Transfer / IBAN ─────────────────────────────────────────
BANK_ACCOUNT_TITLE="EduOS Technologies Pvt Ltd"
BANK_IBAN=PK00XXXX0000000000000000
BANK_NAME=Meezan Bank
BANK_BRANCH_CODE=0001

# ── Super Admin ───────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=superadmin@eduos.pk
SUPER_ADMIN_PASSWORD=ChangeThisInProduction!

# ── Storage (for file uploads) ───────────────────────────────────
STORAGE_DRIVER=local
# For S3-compatible storage:
# STORAGE_DRIVER=s3
# S3_BUCKET=eduos-uploads
# S3_REGION=ap-south-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=

# ── AI Features ───────────────────────────────────────────────────
OPENAI_API_KEY=
AI_ENABLED=false

# ── Kafka (optional — ECONNREFUSED is non-fatal) ─────────────────
KAFKA_BROKER=localhost:9092
KAFKA_ENABLED=false
