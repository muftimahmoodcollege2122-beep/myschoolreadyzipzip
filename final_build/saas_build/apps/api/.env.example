# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/myschoolapp?connection_limit=5&pool_timeout=10
# Optional: point to a read replica for heavy queries (reports, analytics, dashboard)
DATABASE_READ_URL=

# For Neon at scale: use the "-pooler" endpoint (transaction-mode PgBouncer),
# not the direct endpoint -- direct connections don't scale past a handful
# of pods. pgbouncer=true is auto-added when a pooler endpoint is detected.
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/myschoolapp?sslmode=require
DB_POOL_MAX=5
DB_REPLICA_POOL_MAX=3

# ── PgBouncer (production — set these when using PgBouncer) ──────────────────
# DATABASE_URL=postgresql://postgres:password@pgbouncer:6432/myschoolapp?pgbouncer=true&connection_limit=5

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-this-to-64-char-random-secret-in-production
JWT_REFRESH_SECRET=change-this-to-another-64-char-random-secret-in-production

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005
FRONTEND_URL=http://localhost:3005
API_BASE_URL=http://localhost:3001

# ── Kafka (disable in dev by leaving blank) ───────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_USERNAME=
KAFKA_PASSWORD=

# ── AWS S3 ────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=myschoolapp-uploads

# ── Email (SES) ───────────────────────────────────────────────────────────────
SES_SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SES_SMTP_USER=
SES_SMTP_PASS=

# ── SMS (Twilio) ──────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# ── Scale Tuning ──────────────────────────────────────────────────────────────
# Max tenants in L1 memory cache per pod (each ~1KB)
TENANT_L1_CACHE_SIZE=1000
# Slow query threshold in ms (logged as warning)
SLOW_QUERY_THRESHOLD_MS=200
