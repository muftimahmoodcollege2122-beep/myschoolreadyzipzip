  description String?
  isActive    Boolean  @default(true)
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions   Question[]

  @@index([tenantId, schoolId])
  @@map("question_banks")
}

model Question {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
