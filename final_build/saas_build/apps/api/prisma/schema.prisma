// ============================================================
// HOSTEL ENHANCEMENTS
// ============================================================

model HostelRoom {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hostelId   String   @db.Uuid
  tenantId   String   @db.Uuid
  roomNumber String
  type       String   @default("SHARED") // SHARED / PRIVATE / DORMITORY
  capacity   Int      @default(4)
  floor      Int      @default(0)
  facilities String[]
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  allocations HostelAllocation[]

  @@unique([hostelId, roomNumber])
  @@index([tenantId, hostelId])
  @@map("hostel_rooms")
}

model HostelAllocation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId      String   @db.Uuid
  studentId   String   @db.Uuid
  tenantId    String   @db.Uuid
  joinedAt    DateTime @default(now())
  leftAt      DateTime?
  isActive    Boolean  @default(true)
  bedNumber   String?
  monthlyFee  Decimal? @db.Decimal(10,2)
  createdAt   DateTime @default(now())

  room        HostelRoom @relation(fields: [roomId], references: [id])

  @@unique([roomId, studentId, joinedAt])
  @@index([tenantId, studentId])
  @@map("hostel_allocations")
}
