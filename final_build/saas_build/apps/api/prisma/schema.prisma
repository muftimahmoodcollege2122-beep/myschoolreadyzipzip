model BlogPost {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @db.Uuid
  schoolId       String   @db.Uuid
  title          String
  slug           String
  content        String
  excerpt        String?
  coverUrl       String?
