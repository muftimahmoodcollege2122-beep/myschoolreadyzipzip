enum QuestionType {
  MCQ
  SHORT_ANSWER
  LONG_ANSWER
  TRUE_FALSE
  FILL_BLANK
  PRACTICAL
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  VERY_HARD
}

model QuestionBank {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @db.Uuid
  schoolId    String   @db.Uuid
