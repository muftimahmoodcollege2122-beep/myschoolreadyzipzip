// ============================================================
// EXAM ENHANCEMENTS — HALL, SEATING, MERIT, MODERATION
// ============================================================

model ExamHall {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @db.Uuid
  schoolId    String   @db.Uuid
  name        String
  capacity    Int
  rows        Int      @default(10)
  columns     Int      @default(5)
  facilities  String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  seatings    ExamSeating[]

  @@index([tenantId, schoolId])
  @@map("exam_halls")
}

model ExamSeating {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @db.Uuid
  examId     String   @db.Uuid
  hallId     String   @db.Uuid
  studentId  String   @db.Uuid
  seatNumber String
  rowNo      Int?
  colNo      Int?
  createdAt  DateTime @default(now())

  hall       ExamHall @relation(fields: [hallId], references: [id])

  @@unique([examId, hallId, seatNumber])
  @@unique([examId, studentId])
  @@index([tenantId, examId])
  @@map("exam_seatings")
}

model ExamModeration {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @db.Uuid
  examId       String   @db.Uuid
  moderatorId  String   @db.Uuid
  status       String   @default("PENDING") // PENDING / IN_PROGRESS / COMPLETED
  checklist    Json     @default("[]")
  comments     String?
  completedAt  DateTime?
  createdAt    DateTime @default(now())

  @@unique([examId, moderatorId])
  @@index([tenantId, examId])
  @@map("exam_moderations")
}

model ExamRevaluation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @db.Uuid
  examId         String   @db.Uuid
  studentId      String   @db.Uuid
  requestedById  String   @db.Uuid
  reason         String
  status         String   @default("PENDING") // PENDING / IN_PROGRESS / COMPLETED / REJECTED
  originalMarks  Decimal  @db.Decimal(8,2)
  revisedMarks   Decimal? @db.Decimal(8,2)
  remarks        String?
  processedById  String?  @db.Uuid
  processedAt    DateTime?
  createdAt      DateTime @default(now())

  @@index([tenantId, examId])
  @@index([tenantId, studentId])
  @@map("exam_revaluations")
}

model MeritListEntry {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @db.Uuid
  examId       String   @db.Uuid
  studentId    String   @db.Uuid
  classId      String?  @db.Uuid
  sectionId    String?  @db.Uuid
  rank         Int
  totalMarks   Decimal  @db.Decimal(8,2)
  obtainedMarks Decimal @db.Decimal(8,2)
  percentage   Decimal  @db.Decimal(5,2)
  grade        String
  gpa          Decimal? @db.Decimal(3,2)
  isClassTopper Boolean @default(false)
  isSectionTopper Boolean @default(false)
  createdAt    DateTime @default(now())

  @@unique([examId, studentId])
  @@index([tenantId, examId])
  @@map("merit_list_entries")
}

// ============================================================
