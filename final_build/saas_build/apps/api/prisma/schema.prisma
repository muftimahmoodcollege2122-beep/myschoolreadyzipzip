model GalleryAlbum {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @db.Uuid
  schoolId    String   @db.Uuid
  title       String
  description String?
  coverUrl    String?
  isPublic    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       GalleryItem[]

  @@index([tenantId, schoolId])
  @@map("gallery_albums")
}

model GalleryItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  albumId     String   @db.Uuid
  tenantId    String   @db.Uuid
  url         String
  thumbnailUrl String?
  type        String   @default("IMAGE") // IMAGE / VIDEO
  title       String?
  caption     String?
  sortOrder   Int      @default(0)
  fileSize    Int?
  mimeType    String?
  createdAt   DateTime @default(now())

  album       GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([tenantId, albumId])
  @@map("gallery_items")
}

// ============================================================
// SUPPORT TICKET SYSTEM
// ============================================================

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

model SupportTicket {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String        @db.Uuid
  ticketNo      String        @unique
  subject       String
  description   String
  priority      TicketPriority @default(MEDIUM)
  status        TicketStatus   @default(OPEN)
  category      String         // BILLING / TECHNICAL / ACADEMIC / FEATURE_REQUEST / OTHER
  submittedById String         @db.Uuid
  assignedToId  String?        @db.Uuid
  resolvedAt    DateTime?
  closedAt      DateTime?
  slaDeadline   DateTime?
  satisfaction  Int?           // 1-5
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  responses     TicketResponse[]

  @@index([tenantId])
  @@index([status, priority])
  @@map("support_tickets")
}

model TicketResponse {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId    String   @db.Uuid
  tenantId    String   @db.Uuid
  authorId    String   @db.Uuid
  content     String
  isInternal  Boolean  @default(false)
  attachments Json     @default("[]")
  createdAt   DateTime @default(now())

  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_responses")
}

// ============================================================
// SAAS COUPON SYSTEM
// ============================================================

model Coupon {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String   @unique
  description    String?
  type           String   // PERCENTAGE / FIXED
  value          Decimal  @db.Decimal(8,2)
  maxUses        Int?
  usedCount      Int      @default(0)
  minAmount      Decimal? @db.Decimal(10,2)
  applicablePlans Json    @default("[]")
  validFrom      DateTime
  validTo        DateTime?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  usages         CouponUsage[]

  @@map("coupons")
}

model CouponUsage {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  couponId       String   @db.Uuid
  tenantId       String   @db.Uuid
  discountAmount Decimal  @db.Decimal(10,2)
  appliedAt      DateTime @default(now())

  coupon         Coupon   @relation(fields: [couponId], references: [id])

  @@index([couponId])
  @@index([tenantId])
  @@map("coupon_usages")
}

