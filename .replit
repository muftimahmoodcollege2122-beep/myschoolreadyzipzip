modules = ["nodejs-20", "bash"]
[nix]
channel = "stable-25_05"

[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Admin Portal"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Teacher Portal"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Student Portal"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Parent Portal"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash start.sh"
waitForPort = 5000

[[workflows.workflow]]
name = "Admin Portal"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c \"until curl -sf http://localhost:3001/api/v1/health/live >/dev/null 2>&1; do sleep 3; done && cd /home/runner/workspace/final_build/saas_build/apps/admin && NEXT_PUBLIC_API_URL=http://localhost:3001 /home/runner/workspace/final_build/saas_build/node_modules/.bin/next dev -p 8080\""
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Teacher Portal"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c \"until curl -sf http://localhost:3001/api/v1/health/live >/dev/null 2>&1; do sleep 3; done && cd /home/runner/workspace/final_build/saas_build/apps/teacher && NEXT_PUBLIC_API_URL=http://localhost:3001 /home/runner/workspace/final_build/saas_build/node_modules/.bin/next dev -p 3002\""
waitForPort = 3002

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Student Portal"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c \"until curl -sf http://localhost:3001/api/v1/health/live >/dev/null 2>&1; do sleep 3; done && cd /home/runner/workspace/final_build/saas_build/apps/student && NEXT_PUBLIC_API_URL=http://localhost:3001 /home/runner/workspace/final_build/saas_build/node_modules/.bin/next dev -p 3003\""
waitForPort = 3003

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Parent Portal"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c \"until curl -sf http://localhost:3001/api/v1/health/live >/dev/null 2>&1; do sleep 3; done && cd /home/runner/workspace/final_build/saas_build/apps/parent && NEXT_PUBLIC_API_URL=http://localhost:3001 /home/runner/workspace/final_build/saas_build/node_modules/.bin/next dev -p 4200\""
waitForPort = 4200

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 3002
externalPort = 3002

[[ports]]
localPort = 3003
externalPort = 3003

[[ports]]
localPort = 3004
externalPort = 5000

[[ports]]
localPort = 3005
externalPort = 3002

[[ports]]
localPort = 4200
externalPort = 4200

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 6379
externalPort = 3000

[[ports]]
localPort = 8080
externalPort = 8080

[userenv]

[userenv.shared]
NODE_ENV = "development"
PORT = "3001"
REDIS_HOST = "localhost"
REDIS_PORT = "6379"
CORS_ORIGINS = "http://localhost:5000,https://localhost:5000"
JWT_ACCESS_SECRET = "school-saas-access-secret-dev-2024"
JWT_REFRESH_SECRET = "school-saas-refresh-secret-dev-2024"
NEXT_PUBLIC_API_URL = "http://localhost:3001"
FRONTEND_URL = "https://${REPLIT_DEV_DOMAIN}"
API_BASE_URL = "http://localhost:3001"
KAFKA_BROKERS = ""
AWS_REGION = "ap-south-1"
AWS_S3_BUCKET = "myschoolapp-uploads"
