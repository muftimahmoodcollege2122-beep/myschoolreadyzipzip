modules = ["nodejs-20"]
[nix]
channel = "stable-25_05"

[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash start.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 6379
externalPort = 80

[userenv]

[userenv.shared]
NODE_ENV = "development"
PORT = "3001"
REDIS_HOST = "localhost"
REDIS_PORT = "6379"
CORS_ORIGINS = "http://localhost:5000,https://localhost:5000"
JWT_ACCESS_SECRET = "school-saas-access-secret-dev-2024"
JWT_REFRESH_SECRET = "school-saas-refresh-secret-dev-2024"
NEXT_PUBLIC_API_URL = "http://localhost:3001"
